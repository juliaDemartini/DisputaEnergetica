<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="32dp"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="#263238"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvRoletaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROLETA DA ENERGIA"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieRoleta"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp"
            app:lottie_rawRes="@raw/roleta_animada"
            app:lottie_loop="true"
            app:lottie_autoPlay="false"/>

        <TextView
            android:id="@+id/tvResultadoRoleta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+10 Energia!"
            android:textColor="#00E676"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGirarRoleta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:backgroundTint="@color/green_button"
            android:text="GIRAR ROLETA"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>