<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvTurnoBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="32dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvTurnoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUA VEZ!"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvTurnoJogadorNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jogador"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_marginBottom="20dp"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieDado"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="24dp"
            android:visibility="visible"
            app:lottie_rawRes="@raw/dado_animado"
            app:lottie_loop="true"
            app:lottie_autoPlay="false"/>

        <TextView
            android:id="@+id/tvResultadoDado"
            android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginBottom="24dp"
            android:gravity="center" android:text="6"
            android:textColor="@color/white"
            android:textSize="110sp" android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnModalRollDice"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/white"
            android:text="GIRAR DADO"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="visible" />

    </LinearLayout>
</androidx.cardview.widget.CardView>