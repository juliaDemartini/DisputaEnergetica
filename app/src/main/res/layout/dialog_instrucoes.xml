<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="380dp" android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D2C3A"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnFecharInstrucoes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Fechar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTituloInstrucoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGRAS DO JOGO"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ScrollView
            android:id="@+id/svConteudoInstrucoes"
            android:layout_width="0dp"
            android:layout_height="320dp" android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/tvTituloInstrucoes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:id="@+id/ivPreviewTabuleiro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tabuleiro"
                        android:background="#12384A"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:lineSpacingExtra="5dp"
                    android:text="🎲 1. Preparação\nCada jogador escolhe sua cor e posiciona seu peão no INÍCIO.\n\n🎲 2. Jogando\nJogue o dado e avance o número de casas indicado.\n\n⚡ Casa Comum: Ganhe ou perca recursos conforme a instrução da casa.\n\n❓ Casa Sorte: Responda a uma pergunta sobre energia e sustentabilidade.\n• Acertou: ganha bônus.\n• Errou: recebe uma penalidade.\n\n🏁 3. Fim do Jogo\nAo chegar à CHEGADA, os recursos são somados e os pontos calculados. O jogador com o melhor desempenho se torna o Vencedor da Transição Energética. 🌱⚡🏆" />

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnBaixarPdf"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/green_button"
            android:text="📥 BAIXAR TABULEIRO"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/svConteudoInstrucoes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnVerManual"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="📄 BAIXAR MANUAL"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:strokeColor="@color/white"
            app:strokeWidth="1.5dp"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnBaixarPdf"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>