<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFF" app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"> <TextView
        android:id="@+id/tvNomeJogadorPlacar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome do Jogador"
        android:textColor="@color/black" android:textStyle="bold"
        android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvRecursosJogadorPlacar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Moedas: 5 | Energia: 3 | Sustentabilidade: 4 | Poluição: 1"
            android:textColor="@color/black" android:textSize="13sp"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>