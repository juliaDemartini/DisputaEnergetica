<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D2C3A"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customizar Jogador"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivPreviewPeao"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_energy"
            app:tint="#FF2E2E"
            app:layout_constraintTop_toBottomOf="@id/tvTituloEditar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Preview do Peão" />

        <EditText
            android:id="@+id/etEditarNome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/editTextBackground"
            android:backgroundTint="@color/white"
            android:hint="Apelido do Jogador"
            android:textColorHint="#80FFFFFF"
            android:textColor="@color/white"
            android:gravity="center"
            android:inputType="textPersonName"
            android:importantForAutofill="no"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/ivPreviewPeao" />

        <TextView
            android:id="@+id/tvLabelCores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESCOLHA SUA COR"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/etEditarNome"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/llCores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelCores">

            <View
                android:id="@+id/viewCorVermelho"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_margin="4dp"
                android:background="@android:drawable/presence_online"
                android:backgroundTint="#FF2E2E"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Cor Vermelha" /> <View
            android:id="@+id/viewCorAzul"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@android:drawable/presence_online"
            android:backgroundTint="#2E7DFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cor Azul" /> <View
            android:id="@+id/viewCorVerde"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@android:drawable/presence_online"
            android:backgroundTint="#2EFF3A"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cor Verde" /> <View
            android:id="@+id/viewCorAmarelo"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@android:drawable/presence_online"
            android:backgroundTint="#FFD42E"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cor Amarela" /> </LinearLayout>

        <Button
            android:id="@+id/btnSalvarCustomizacao"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/green_button"
            android:text="SALVAR ALTERAÇÕES"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/llCores" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>