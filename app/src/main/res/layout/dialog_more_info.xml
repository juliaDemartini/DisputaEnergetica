<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D2C3A"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Manual do Jogo"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnFecharInfo"
            app:layout_constraintBottom_toBottomOf="@id/btnFecharInfo"/>

        <ImageView
            android:id="@+id/btnFecharInfo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Fechar caixa de diálogo"
            android:importantForAccessibility="yes"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="280dp" android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnFecharInfo"
            app:layout_constraintBottom_toTopOf="@id/btnEntendiInfo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Como Jogar:"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Cada jogador rola o dado ou roleta no seu turno.\n2. Avance pelas casas e gerencie seus recursos ecológicos."
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cores das Casas do Tabuleiro:"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🟣 Roxa: Casa da Roleta. Gire para testar sua sorte em eventos neutros."
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🟡 Amarela: Casa de Evento Sorte. Uma consequência inesperada vai acontecer!"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔴 Vermelha: Casa de Evento Escolha. Tome decisões estratégicas sobre energia."
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Entendendo os Recursos:"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💰 Moedas: Seu dinheiro para investimentos e taxas.\n⚡ Energia: Capacidade de operação do seu projeto.\n🌱 Sustentabilidade: Seus pontos de vitória ecológicos!\n⚠️ Poluição: Seu impacto negativo. Reduza para pontuar mais."
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Objetivo Final:"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O jogador que alcançar a maior pontuação de Sustentabilidade combinada com o menor nível de Poluição ao fim do circuito será o vencedor!"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnEntendiInfo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/green_button"
            android:text="ENTENDI"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>